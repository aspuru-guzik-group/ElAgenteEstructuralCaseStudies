import numpy as np, itertools, math
from collections import defaultdict

# --- utilities ---
def read_xyz(fname):
    elems=3D[]; pts=3D[]
    with open(fname) as f:
        lines=3Df.read().splitlines()
    for line in lines[2:]:
        if not line.strip():
            continue
        p=3Dline.split()
        elems.append(p[0])
        pts.append([float(x) for x in p[1:4]])
    return elems, np.array(pts, float)

def write_xyz(fname, elems, pts, comment=3D''):
    with open(fname,'w') as f:
        f.write(f'{len(elems)}\n')
        f.write(comment+'\n')
        for e,p in zip(elems,pts):
            f.write(f'{e:2s} {p[0]: .8f} {p[1]: .8f} {p[2]: .8f}\n')

def rotation_matrix_from_vectors(a,b):
    a=3Dnp.array(a,float); b=3Dnp.array(b,float)
    a=3Da/np.linalg.norm(a); b=3Db/np.linalg.norm(b)
    v=3Dnp.cross(a,b)
    c=3Dnp.dot(a,b)
    if np.linalg.norm(v) &lt; 1e-12:
        if c &gt; 0.999999999:
            return np.eye(3)
        axis=3Dnp.array([1.0,0.0,0.0])
        if abs(np.dot(axis,a)) &gt; 0.9:
            axis=3Dnp.array([0.0,1.0,0.0])
        v=3Dnp.cross(a,axis); v=3Dv/np.linalg.norm(v)
        K=3Dnp.array([[0,-v[2],v[1]],[v[2],0,-v[0]],[-v[1],v[0],0]])
        return np.eye(3)+2*K@K
    s=3Dnp.linalg.norm(v)
    K=3Dnp.array([[0,-v[2],v[1]],[v[2],0,-v[0]],[-v[1],v[0],0]])
    return np.eye(3)+K+K@K*((1-c)/(s**2))

def axis_rotation_matrix(axis, angle_deg):
    axis=3Dnp.array(axis,float); axis=3Daxis/np.linalg.norm(axis)
    x,y,z=3Daxis
    a=3Dmath.radians(angle_deg)
    c=3Dmath.cos(a); s=3Dmath.sin(a); C=3D1-c
    return np.array([
        [c+x*x*C, x*y*C-z*s, x*z*C+y*s],
        [y*x*C+z*s, c+y*y*C, y*z*C-x*s],
        [z*x*C-y*s, z*y*C+x*s, c+z*z*C],
    ])

def plane_normal(points):
    c=3Dpoints.mean(0)
    _,_,vh=3Dnp.linalg.svd(points-c)
    return vh[-1], c

# --- read structures ---
