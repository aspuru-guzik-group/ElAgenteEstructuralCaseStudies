cycles=3Dset()
for start in range(len(sp)):
    if se[start] !=3D 'C':
        continue
    stack=3D[(start,[start])]
    while stack:
        cur,path=3Dstack.pop()
        if len(path)=3D=3D6:
            if start in adj[cur]:
                cyc=3Dpath[:]
                rots=3D[]
                for s in range(6): rots.append(tuple(cyc[s:]+cyc[:s]))
                rc=3Dlist(reversed(cyc))
                for s in range(6): rots.append(tuple(rc[s:]+rc[:s]))
                cycles.add(min(rots))
            continue
        for nb in adj[cur]:
            if se[nb] !=3D 'C' or nb in path or nb &lt; start:
                continue
            stack.append((nb,path+[nb]))
cycles=3Dsorted(cycles)

# identify central ring as closest centroid to molecular centroid
mol_cent=3Dsp.mean(0)
central=3Dmin(cycles, key=3Dlambda cyc: np.linalg.norm(sp[list(cyc)].mean(0=
)-mol_cent))
peripherals=3D[cyc for cyc in cycles if cyc !=3D central]
# choose one representative peripheral ring
ring=3Dperipherals[0]  # symmetry-equivalent representative
ring_idx=3Dlist(ring)

# global convex axis from central ring
