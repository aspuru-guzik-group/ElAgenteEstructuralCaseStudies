# Read xyz helper

def read_xyz(path):
    with open(path) as f:
        lines =3D f.read().splitlines()
    n =3D int(lines[0])
    atoms=3D[]
    for line in lines[2:2+n]:
        t=3Dline.split()
        atoms.append((t[0], np.array(list(map(float,t[1:4])))))
    return atoms

