import numpy as np
from math import pi, cos, sin, sqrt


def normalize(v):
    v =3D np.array(v, dtype=3Dfloat)
    n =3D np.linalg.norm(v)
    if n &lt; 1e-12:
        raise ValueError('zero vector')
    return v / n


def orthonormal_basis(n):
    n =3D normalize(n)
    tmp =3D np.array([0.0, 0.0, 1.0])
    if abs(np.dot(n, tmp)) &gt; 0.9:
        tmp =3D np.array([0.0, 1.0, 0.0])
    u =3D normalize(np.cross(n, tmp))
    v =3D normalize(np.cross(n, u))
    return u, v


def cp_ring(centroid, normal, phase=3D0.0, R=3D1.19, CH=3D1.08):
    centroid =3D np.array(centroid, float)
    u, v =3D orthonormal_basis(normal)
    atoms =3D []
    for i in range(5):
        th =3D phase + 2*pi*i/5
        radial =3D cos(th)*u + sin(th)*v
        c =3D centroid + R*radial
        h =3D c + CH*radial
        atoms.append(("C", c))
        atoms.append(("H", h))
    return atoms


def add_ch3(carbon, neighbor_dirs, bond=3D1.09, phase=3D0.0):
    carbon =3D np.array(carbon, float)
    # neighbor_dirs: list of vectors from carbon to interacting heavy atoms
    axis =3D -normalize(np.sum([normalize(v) for v in neighbor_dirs], axis=
=3D0))
    e1, e2 =3D orthonormal_basis(axis)
    # tetrahedral angle with axis opposite heavy-atom direction group
    c =3D 1.0/3.0
    s =3D sqrt(1.0 - c*c)
    Hs =3D []
    for k in range(3):
        ph =3D phase + 2*pi*k/3
        d =3D normalize(c*axis + s*(cos(ph)*e1 + sin(ph)*e2))
        Hs.append(("H", carbon + bond*d))
    return Hs


def add_ch2_sp3(carbon, n1, n2, bond=3D1.09):
    carbon =3D np.array(carbon, float)
    u1 =3D normalize(n1)
    u2 =3D normalize(n2)
    cross =3D np.cross(u1, u2)
    if np.linalg.norm(cross) &lt; 1e-6:
        # fallback
        axis =3D -u1
        e1, _ =3D orthonormal_basis(axis)
        H1 =3D normalize(axis + 0.95*e1)
        H2 =3D normalize(axis - 0.95*e1)
    else:
        p =3D normalize(cross)
        m =3D normalize(u1 + u2)
        c =3D (1.0/3.0) / max(np.dot(m, u1), 0.35)
        c =3D min(c, 0.95)
        s =3D sqrt(max(1.0 - c*c, 1e-8))
        H1 =3D normalize(-c*m + s*p)
        H2 =3D normalize(-c*m - s*p)
    return [("H", carbon + bond*H1), ("H", carbon + bond*H2)]


def add_ch2_sp2(carbon, carbon_neighbor, plane_normal, bond=3D1.09):
    carbon =3D np.array(carbon, float)
    u =3D normalize(carbon_neighbor)
    n =3D normalize(plane_normal)
    p =3D normalize(np.cross(n, u))
    H1 =3D normalize(-0.5*u + (sqrt(3)/2.0)*p)
    H2 =3D normalize(-0.5*u - (sqrt(3)/2.0)*p)
    return [("H", carbon + bond*H1), ("H", carbon + bond*H2)]


def write_xyz(path, atoms, comment=3D""):
    with open(path, 'w') as f:
        f.write(f"{len(atoms)}\n")
        f.write(comment + "\n")
        for el, xyz in atoms:
            x, y, z =3D xyz
            f.write(f"{el:2s} {x:12.6f} {y:12.6f} {z:12.6f}\n")


def dist(a, b):
    return float(np.linalg.norm(np.array(a) - np.array(b)))


def build_common_cp():
    zr =3D np.array([0.0, 0.0, 0.0])
    c1 =3D np.array([-1.45, 0.00, 1.75])
    c2 =3D np.array([-1.45, 0.00, -1.75])
    ring1 =3D cp_ring(c1, zr - c1, phase=3D0.35)
    ring2 =3D cp_ring(c2, zr - c2, phase=3D-0.25)
    return zr, ring1, ring2


def build_reactant():
    zr, ring1, ring2 =3D build_common_cp()
    atoms =3D [("Zr", zr)] + ring1 + ring2

    cm =3D np.array([1.80, -1.30, -0.30])
    ca =3D np.array([2.30,  0.70,  0.67])
    cb =3D np.array([2.30,  0.70, -0.67])

    atoms +=3D [("C", cm), ("C", ca), ("C", cb)]
    atoms +=3D add_ch3(cm, [zr - cm], phase=3D0.1)
    # Ethylene treated as sp2 in plane defined by C=3DC and Zr vector; use =
normal from cross(CC, Zr-centroid)
    cc =3D cb - ca
    plane_n =3D np.cross(cc, zr - (ca + cb)/2)
    if np.linalg.norm(plane_n) &lt; 1e-6:
        plane_n =3D np.array([0.0, 1.0, 0.0])
    atoms +=3D add_ch2_sp2(ca, cb - ca, plane_n)
    atoms +=3D add_ch2_sp2(cb, ca - cb, plane_n)

    comment =3D (
        "Idealized reactant: [Cp2Zr(CH3)(eta2-C2H4)]+ ; Cp =3D unsubstitute=
d cyclopentadienyl"
    )
    return atoms, comment, {
        'Zr-Cm': dist(zr, cm),
        'C=3DC': dist(ca, cb),
        'Zr-Ca': dist(zr, ca),
        'Zr-Cb': dist(zr, cb),
        'Cm...Cb': dist(cm, cb),
    }


def build_ts_like():
    zr, ring1, ring2 =3D build_common_cp()
    atoms =3D [("Zr", zr)] + ring1 + ring2

    ca =3D np.array([2.15,  0.45,  0.55])   # alpha carbon: remains metal-b=
ound in product
    cb =3D np.array([3.08,  1.22, -0.04])   # beta carbon: receives migrati=
ng methyl
    cm =3D np.array([2.38, -0.52, -0.58])   # migrating methyl carbon

    atoms +=3D [("C", ca), ("C", cb), ("C", cm)]
    # TS-like H placement: approximate only
    atoms +=3D add_ch2_sp3(ca, zr - ca, cb - ca)
    atoms +=3D add_ch2_sp3(cb, ca - cb, cm - cb)
    atoms +=3D add_ch3(cm, [zr - cm, cb - cm], phase=3D0.2)

    comment =3D (
        "Idealized TS-like geometry for ethylene insertion into Zr-CH3; par=
tial bonds implied by distances, not a computed TS"
    )
    return atoms, comment, {
        'Zr-Ca': dist(zr, ca),
        'Ca-Cb': dist(ca, cb),
        'Cb...Cm': dist(cb, cm),
        'Zr...Cm': dist(zr, cm),
    }


def build_product():
    zr, ring1, ring2 =3D build_common_cp()
    atoms =3D [("Zr", zr)] + ring1 + ring2

    ca =3D np.array([2.20, 0.40, 0.60])
    cb =3D np.array([3.05, 1.35, -0.25])
    cm =3D np.array([3.30, 2.45, -1.30])

    atoms +=3D [("C", ca), ("C", cb), ("C", cm)]
    atoms +=3D add_ch2_sp3(ca, zr - ca, cb - ca)
    atoms +=3D add_ch2_sp3(cb, ca - cb, cm - cb)
    atoms +=3D add_ch3(cm, [cb - cm], phase=3D0.3)

    comment =3D (
        "Idealized product: [Cp2Zr(CH2CH2CH3)]+ after 1,2-insertion of ethy=
lene into the Zr-CH3 bond"
    )
    return atoms, comment, {
        'Zr-Ca': dist(zr, ca),
        'Ca-Cb': dist(ca, cb),
        'Cb-Cm': dist(cb, cm),
    }


def write_multi_xyz(path, entries):
    with open(path, 'w') as f:
        for atoms, comment, _ in entries:
            f.write(f"{len(atoms)}\n{comment}\n")
            for el, xyz in atoms:
                x, y, z =3D xyz
                f.write(f"{el:2s} {x:12.6f} {y:12.6f} {z:12.6f}\n")


def main():
    react =3D build_reactant()
    ts =3D build_ts_like()
    prod =3D build_product()
    write_xyz('reactant.xyz', react[0], react[1])
    write_xyz('ts_like.xyz', ts[0], ts[1])
    write_xyz('product.xyz', prod[0], prod[1])
    write_multi_xyz('zr_insertion_structures.xyz', [react, ts, prod])

    for name, data in [('reactant', react), ('ts_like', ts), ('product', pr=
od)]:
        print(name)
        for k, v in data[2].items():
            print(f'  {k}: {v:.3f} =C3=85')

if __name__ =3D=3D '__main__':
    main()
