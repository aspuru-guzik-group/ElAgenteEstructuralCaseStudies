# ---------- output ----------
def write_xyz(filename, atoms, title):
    with open(filename, 'w') as f:
        f.write(f"{len(atoms)}\n")
        f.write(title + "\n")
        for el, xyz, label in atoms:
            x, y, z =3D xyz
            f.write(f"{el:2s} {x:12.6f} {y:12.6f} {z:12.6f}  # {label}\n")

def report_distances(name, atoms):
    # selected heavy-atom distances for sanity
    pos =3D {label: np.array(xyz) for el, xyz, label in atoms}
    print(f'[{name}]')
    if name =3D=3D 'reactant':
        print('  Zr-MeC   ', np.linalg.norm(pos['Zr'] - pos['MeC']))
