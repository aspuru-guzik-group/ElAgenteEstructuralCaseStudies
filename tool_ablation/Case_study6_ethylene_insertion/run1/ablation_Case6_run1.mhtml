import math
import numpy as np
from pathlib import Path

OUT =3D Path('.')

# ---------- vector helpers ----------
def norm(v):
    v =3D np.array(v, dtype=3Dfloat)
    n =3D np.linalg.norm(v)
    if n &lt; 1e-12:
        raise ValueError('zero vector')
    return v / n

def orthonormal_basis(n):
    n =3D norm(n)
    ref =3D np.array([1.0, 0.0, 0.0])
    if abs(np.dot(n, ref)) &gt; 0.85:
        ref =3D np.array([0.0, 1.0, 0.0])
    u =3D np.cross(n, ref)
    u =3D norm(u)
    v =3D np.cross(n, u)
    v =3D norm(v)
    return u, v

# ---------- geometry builders ----------
def cp_ring(centroid, metal=3Dnp.zeros(3), c_r=3D1.19, ch=3D1.08, phase_deg=
=3D0.0, ring_name=3D'Cp'):
    centroid =3D np.array(centroid, float)
    n =3D norm(metal - centroid)  # normal pointing toward metal
    u, v =3D orthonormal_basis(n)
    phase =3D math.radians(phase_deg)
    atoms =3D []
    carbons =3D []
    for i in range(5):
        ang =3D phase + 2 * math.pi * i / 5
        radial =3D math.cos(ang) * u + math.sin(ang) * v
        c =3D centroid + c_r * radial
        h =3D centroid + (c_r + ch) * radial
        carbons.append(c)
        atoms.append(('C', c, f'{ring_name}C{i+1}'))
    for i, c in enumerate(carbons):
        radial =3D norm(c - centroid)
        h =3D centroid + (c_r + ch) * radial
        atoms.append(('H', h, f'{ring_name}H{i+1}'))
    return atoms

def add_sp3_one_bond(center, attached, bond_len=3D1.09, label_prefix=3D'H')=
:
    center =3D np.array(center, float)
    n =3D norm(np.array(attached, float) - center)  # to attached atom
    u, v =3D orthonormal_basis(n)
    atoms =3D []
    for i, phi_deg in enumerate((0, 120, 240), start=3D1):
        phi =3D math.radians(phi_deg)
        d =3D (-1.0/3.0) * n + (2.0 * math.sqrt(2.0) / 3.0) * (math.cos(phi=
) * u + math.sin(phi) * v)
        d =3D norm(d)
        atoms.append(('H', center + bond_len * d, f'{label_prefix}{i}'))
    return atoms

def add_sp3_two_bonds(center, attached1, attached2, bond_len=3D1.09, label_=
prefix=3D'H'):
    center =3D np.array(center, float)
    n1 =3D norm(np.array(attached1, float) - center)
    n2 =3D norm(np.array(attached2, float) - center)
    b =3D norm(n1 + n2)
    p =3D np.cross(n1, n2)
    if np.linalg.norm(p) &lt; 1e-8:
        # fallback if nearly collinear
        p =3D orthonormal_basis(b)[0]
    else:
        p =3D norm(p)
    alpha =3D math.acos(max(-1.0, min(1.0, float(np.dot(n1, n2)))))
    cos_half =3D max(1e-6, math.cos(alpha / 2.0))
    a =3D min(0.999, 1.0 / (3.0 * cos_half))
    c =3D math.sqrt(max(1e-8, 1.0 - a*a))
    d1 =3D norm(-a * b + c * p)
    d2 =3D norm(-a * b - c * p)
    return [('H', center + bond_len * d1, f'{label_prefix}1'), ('H', center=
 + bond_len * d2, f'{label_prefix}2')]

def add_sp2_alkene_hydrogens(center, other_c, plane_normal, bond_len=3D1.08=
, label_prefix=3D'H'):
    center =3D np.array(center, float)
    other_c =3D np.array(other_c, float)
    t =3D norm(other_c - center)  # toward alkene partner
    n =3D norm(plane_normal)
    # in-plane perpendicular to C=3DC direction
    w =3D np.cross(n, t)
    if np.linalg.norm(w) &lt; 1e-8:
        w =3D orthonormal_basis(t)[0]
    else:
        w =3D norm(w)
    d1 =3D norm(-0.5 * t + (math.sqrt(3)/2.0) * w)
    d2 =3D norm(-0.5 * t - (math.sqrt(3)/2.0) * w)
    return [('H', center + bond_len * d1, f'{label_prefix}1'), ('H', center=
 + bond_len * d2, f'{label_prefix}2')]

def add_sp3_three_bonds(center, attached1, attached2, attached3, bond_len=
=3D1.09, label_prefix=3D'H'):
    center =3D np.array(center, float)
    s =3D norm(norm(np.array(attached1)-center) + norm(np.array(attached2)-=
center) + norm(np.array(attached3)-center))
    return [('H', center - bond_len * s, f'{label_prefix}1')]

