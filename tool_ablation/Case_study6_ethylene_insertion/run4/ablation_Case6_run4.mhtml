        n =3D np.cross(a, tmp)
    n =3D norm(n)
    p =3D norm(np.cross(n, a))  # in-plane perpendicular to bond
    d1 =3D norm(-0.5*a + (np.sqrt(3)/2)*p)
    d2 =3D norm(-0.5*a - (np.sqrt(3)/2)*p)
    return [center + bond*d1, center + bond*d2]


