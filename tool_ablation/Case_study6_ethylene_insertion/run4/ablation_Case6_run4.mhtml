# ---------- helpers ----------

def norm(v):
    v =3D np.array(v, dtype=3Dfloat)
    n =3D np.linalg.norm(v)
    if n &lt; 1e-8:
        raise ValueError('zero vector')
    return v / n


def orthonormal_basis(n, ref=3Dnp.array([0.0, 0.0, 1.0])):
    n =3D norm(n)
    ref =3D np.array(ref, dtype=3Dfloat)
    if abs(np.dot(n, ref)) &gt; 0.95:
        ref =3D np.array([0.0, 1.0, 0.0])
    u =3D norm(np.cross(n, ref))
    v =3D norm(np.cross(n, u))
    return u, v


def pentagon(center, normal, radius=3D1.20, phase=3D0.0, h_bond=3D1.08):
    center =3D np.array(center, dtype=3Dfloat)
    normal =3D norm(normal)
    u, v =3D orthonormal_basis(normal)
    carbons, hydrogens =3D [], []
    for k in range(5):
        th =3D phase + 2*pi*k/5
        rdir =3D cos(th)*u + sin(th)*v
        c =3D center + radius*rdir
        h =3D center + (radius + h_bond)*rdir
        carbons.append(c)
        hydrogens.append(h)
    return carbons, hydrogens


def tetra_h3(center, neighbor, bond=3D1.09):
    """CH3 hydrogens for one heavy-atom neighbor."""
    center =3D np.array(center, float)
    a =3D norm(np.array(neighbor, float) - center)  # direction to neighbor
    axis =3D -a  # hydrogens point away from neighbor
    u, v =3D orthonormal_basis(axis)
    theta =3D np.deg2rad(109.47)
    # angle between each H and axis =3D 109.47 - 0? We want tetra arrangeme=
nt.
    # For one neighbor along +a, H directions make 109.47=C2=B0 with +a, eq=
uivalently 70.53=C2=B0 from -a.
    alpha =3D np.deg2rad(70.53)
    hs =3D []
    for k in range(3):
        phi =3D 2*pi*k/3
        d =3D cos(alpha)*axis + sin(alpha)*(cos(phi)*u + sin(phi)*v)
        hs.append(center + bond*d)
    return hs


def sp3_ch2(center, n1, n2, bond=3D1.09):
    """Approximate CH2 hydrogens for carbon bonded to two heavy atoms at ce=
nter-&gt;n1 and center-&gt;n2."""
    center =3D np.array(center, float)
    a =3D norm(np.array(n1, float) - center)
    b =3D norm(np.array(n2, float) - center)
    p =3D -(a + b)
    if np.linalg.norm(p) &lt; 1e-6:
        p =3D np.array([1.0, 0.0, 0.0])
    p =3D norm(p)
    q =3D np.cross(a, b)
    if np.linalg.norm(q) &lt; 1e-6:
        q =3D np.cross(p, np.array([0.0, 0.0, 1.0]))
        if np.linalg.norm(q) &lt; 1e-6:
            q =3D np.cross(p, np.array([0.0, 1.0, 0.0]))
    q =3D norm(q)
    # choose a symmetric spread around p
    lam =3D 0.72
    d1 =3D norm(p + lam*q)
    d2 =3D norm(p - lam*q)
    return [center + bond*d1, center + bond*d2]


def sp2_ch2(center, neighbor, plane_point, bond=3D1.08):
    """Planar alkene CH2; two Hs in the plane defined by center-neighbor-pl=
ane_point."""
    center =3D np.array(center, float)
    a =3D norm(np.array(neighbor, float) - center)
    b =3D np.array(plane_point, float) - center
    n =3D np.cross(a, b)
    if np.linalg.norm(n) &lt; 1e-6:
