import numpy as np
from math import cos, sin, pi
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt


def norm(v):
    v =3D np.array(v, dtype=3Dfloat)
    n =3D np.linalg.norm(v)
    if n &lt; 1e-10:
        raise ValueError('zero vector')
    return v/n


def orthonormal_basis_from_normal(n):
    n =3D norm(n)
    ref =3D np.array([0.0, 1.0, 0.0])
    if abs(np.dot(n, ref)) &gt; 0.9:
        ref =3D np.array([1.0, 0.0, 0.0])
    e1 =3D norm(np.cross(n, ref))
    e2 =3D norm(np.cross(n, e1))
    return e1, e2


def place_ch3_hs(cpos, attached_to, ch=3D1.09):
    cpos =3D np.array(cpos, float)
    u =3D norm(np.array(attached_to, float) - cpos)
    e1, e2 =3D orthonormal_basis_from_normal(u)
    hs =3D []
    for ang in [0, 2*pi/3, 4*pi/3]:
        d =3D -u/3.0 + (2*np.sqrt(2)/3.0)*(cos(ang)*e1 + sin(ang)*e2)
        hs.append(cpos + ch*norm(d))
    return hs


def place_ch2_hs(cpos, neighbor1, neighbor2, ch=3D1.09, spread=3D0.95):
    cpos =3D np.array(cpos, float)
    u1 =3D norm(np.array(neighbor1, float) - cpos)
    u2 =3D norm(np.array(neighbor2, float) - cpos)
    b =3D -(u1 + u2)
    if np.linalg.norm(b) &lt; 1e-6:
        ref =3D np.array([0.0, 0.0, 1.0])
        if abs(np.dot(u1, ref)) &gt; 0.9:
            ref =3D np.array([0.0, 1.0, 0.0])
        b =3D np.cross(u1, ref)
    b =3D norm(b)
    n =3D np.cross(u1, u2)
    if np.linalg.norm(n) &lt; 1e-6:
        e1, _ =3D orthonormal_basis_from_normal(b)
        n =3D e1
    n =3D norm(n)
    d1 =3D norm(b + spread*n)
    d2 =3D norm(b - spread*n)
    return [cpos + ch*d1, cpos + ch*d2]


def add_cp_ring(atoms, bonds, centroid, normal, phase=3D0.0, ring_radius=3D=
1.68, ch=3D1.08):
    e1, e2 =3D orthonormal_basis_from_normal(normal)
    carbons =3D []
    for i in range(5):
        ang =3D phase + 2*pi*i/5
        radial =3D cos(ang)*e1 + sin(ang)*e2
        c =3D centroid + ring_radius*radial
        atoms.append(('C', c))
        ci =3D len(atoms)-1
        carbons.append(ci)
        h =3D c + ch*radial
        atoms.append(('H', h))
        bonds.append((ci, len(atoms)-1, 'solid'))
    for i in range(5):
        bonds.append((carbons[i], carbons[(i+1)%5], 'solid'))


def build_common_scaffold():
    atoms=3D[('Zr', np.array([0.0,0.0,0.0]))]
