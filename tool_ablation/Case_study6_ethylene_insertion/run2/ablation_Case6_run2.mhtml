ocal environment
    add_ch2_sp3(atoms, bonds, c_a, zr, c_b, zr_idx, b_idx, b1=3D'partial', =
b2=3D'partial2')
    # remove duplicate carbon + bond addition from helper by trimming and u=
sing only hydrogens
