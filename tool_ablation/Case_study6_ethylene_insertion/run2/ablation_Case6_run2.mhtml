    # carbons
    a_idx =3D len(atoms); atoms.append(('C', c_a))
    b_idx =3D len(atoms); atoms.append(('C', c_b))
    me_idx =3D len(atoms); atoms.append(('C', c_me))
    # partial / evolving bonds
    bonds.append((zr_idx, a_idx, 'partial'))
    bonds.append((zr_idx, me_idx, 'partial'))
    bonds.append((a_idx, b_idx, 'partial2'))  # lengthened C=3DC / developi=
ng single bond
    bonds.append((b_idx, me_idx, 'partial'))
    # hydrogens
