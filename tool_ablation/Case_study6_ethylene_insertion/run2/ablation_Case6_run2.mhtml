        h =3D c_me + 1.09*d
        atoms.append(('H', h)); bonds.append((me_idx, len(atoms)-1, 'solid'=
))
    return atoms, bonds


def build_product():
    atoms, bonds =3D build_common_scaffold()
    zr_idx =3D 0
