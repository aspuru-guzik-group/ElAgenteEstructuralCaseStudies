    cth2 =3D np.cos(theta/2)
    cosphi =3D min(1.0, 1.0/(max(1e-6, 3*abs(cth2))))
    phi =3D np.arccos(cosphi)
    for sgn in [+1,-1]:
        d =3D norm(np.cos(phi)*bis + sgn*np.sin(phi)*n)
        h =3D c_b + 1.09*d
        atoms.append(('H', h)); bonds.append((b_idx, len(atoms)-1, 'solid')=
)
