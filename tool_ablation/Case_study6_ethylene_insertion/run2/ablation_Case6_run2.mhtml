import numpy as np
from math import cos, sin, pi
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D  # noqa: F401


def norm(v):
    v =3D np.array(v, dtype=3Dfloat)
    n =3D np.linalg.norm(v)
    if n &lt; 1e-8:
        raise ValueError('zero vector')
    return v / n


def orthonormal_basis_from_normal(n):
    n =3D norm(n)
    ref =3D np.array([0.0, 1.0, 0.0])
    if abs(np.dot(n, ref)) &gt; 0.9:
        ref =3D np.array([1.0, 0.0, 0.0])
    e1 =3D norm(np.cross(n, ref))
    e2 =3D norm(np.cross(n, e1))
    return e1, e2


def add_cp_ring(atoms, bonds, centroid, normal, phase=3D0.0, ring_radius=3D=
1.68, ch=3D1.08):
    e1, e2 =3D orthonormal_basis_from_normal(normal)
    c_idx =3D []
    for i in range(5):
        ang =3D phase + 2*pi*i/5
        radial =3D cos(ang)*e1 + sin(ang)*e2
        cpos =3D centroid + ring_radius * radial
        atoms.append(('C', cpos))
        c_idx.append(len(atoms)-1)
        hpos =3D cpos + ch * radial
        atoms.append(('H', hpos))
        bonds.append((c_idx[-1], len(atoms)-1, 'solid'))
    for i in range(5):
        bonds.append((c_idx[i], c_idx[(i+1)%5], 'solid'))
    return c_idx


def add_ch3(atoms, bonds, cpos, attached_to, attach_idx, ch=3D1.09, bond_ty=
pe=3D'solid'):
    cidx =3D len(atoms)
    atoms.append(('C', np.array(cpos, float)))
    bonds.append((cidx, attach_idx, bond_type))
    u =3D norm(np.array(attached_to, float) - np.array(cpos, float))
    e1, e2 =3D orthonormal_basis_from_normal(u)
    for ang in [0, 2*pi/3, 4*pi/3]:
        d =3D -u/3.0 + (2*np.sqrt(2)/3.0)*(cos(ang)*e1 + sin(ang)*e2)
        d =3D norm(d)
        hpos =3D np.array(cpos, float) + ch*d
        atoms.append(('H', hpos))
        bonds.append((cidx, len(atoms)-1, 'solid'))
    return cidx


def add_ch2_sp3(atoms, bonds, cpos, neighbor1, neighbor2, n1_idx, n2_idx=3D=
None, ch=3D1.09, b1=3D'solid', b2=3D'solid'):
    cidx =3D len(atoms)
    atoms.append(('C', np.array(cpos, float)))
    bonds.append((cidx, n1_idx, b1))
    if n2_idx is not None:
        bonds.append((cidx, n2_idx, b2))
    u1 =3D norm(np.array(neighbor1, float) - np.array(cpos, float))
    u2 =3D norm(np.array(neighbor2, float) - np.array(cpos, float))
    bis =3D -(u1 + u2)
    if np.linalg.norm(bis) &lt; 1e-6:
        # fallback for opposite directions
        ref =3D np.array([0.0, 0.0, 1.0])
        if abs(np.dot(u1, ref)) &gt; 0.9:
            ref =3D np.array([0.0, 1.0, 0.0])
        bis =3D np.cross(u1, ref)
    bis =3D norm(bis)
    n =3D np.cross(u1, u2)
    if np.linalg.norm(n) &lt; 1e-6:
        # linear fallback
        n =3D np.cross(bis, [0.0, 0.0, 1.0])
        if np.linalg.norm(n) &lt; 1e-6:
            n =3D np.cross(bis, [0.0, 1.0, 0.0])
    n =3D norm(n)
    theta =3D np.arccos(np.clip(np.dot(u1, u2), -1.0, 1.0))
    cth2 =3D np.cos(theta/2)
    denom =3D 3*abs(cth2) if abs(cth2) &gt; 1e-6 else 1e-6
    cosphi =3D min(1.0, 1.0/denom)
    phi =3D np.arccos(cosphi)
    for sgn in [+1, -1]:
        d =3D norm(np.cos(phi)*bis + sgn*np.sin(phi)*n)
        hpos =3D np.array(cpos, float) + ch*d
        atoms.append(('H', hpos))
        bonds.append((cidx, len(atoms)-1, 'solid'))
    return cidx


def add_ch2_sp2(atoms, bonds, cpos, other_c, other_idx, plane_normal, ch=3D=
1.08, bond_type=3D'solid'):
    cidx =3D len(atoms)
    atoms.append(('C', np.array(cpos, float)))
    bonds.append((cidx, other_idx, bond_type))
    u =3D norm(np.array(other_c, float) - np.array(cpos, float))
    n =3D norm(np.array(plane_normal, float))
    v =3D norm(np.cross(n, u))
    # trigonal planar: hydrogens 120=C2=B0 from C=3DC direction in the alke=
ne plane
    for sgn in [+1, -1]:
        d =3D norm(-0.5*u + sgn*(np.sqrt(3)/2.0)*v)
        hpos =3D np.array(cpos, float) + ch*d
        atoms.append(('H', hpos))
        bonds.append((cidx, len(atoms)-1, 'solid'))
    return cidx


def write_xyz(filename, atoms, comment=3D''):
    with open(filename, 'w') as f:
        f.write(f"{len(atoms)}\n")
        f.write(comment + "\n")
        for el, pos in atoms:
            x, y, z =3D pos
            f.write(f"{el:2s} {x:12.6f} {y:12.6f} {z:12.6f}\n")


def pairwise_min_dist(atoms):
    coords =3D np.array([p for _, p in atoms])
    n =3D len(coords)
    mind =3D 1e9
    pair =3D None
    for i in range(n):
        for j in range(i+1, n):
            d =3D np.linalg.norm(coords[i]-coords[j])
            # ignore bonded H-heavy, etc? this is only coarse sanity check
            if d &lt; mind:
                mind =3D d
                pair =3D (i, j)
    return mind, pair


def build_common_scaffold():
    atoms =3D [('Zr', np.array([0.0, 0.0, 0.0]))]
    bonds =3D []
    d_cp =3D 2.30
    ang =3D np.deg2rad(65.0)
    c1 =3D np.array([-d_cp*cos(ang), 0.0, d_cp*sin(ang)])
    c2 =3D np.array([-d_cp*cos(ang), 0.0, -d_cp*sin(ang)])
    add_cp_ring(atoms, bonds, c1, c1, phase=3D0.2)
    add_cp_ring(atoms, bonds, c2, c2, phase=3D-0.3)
    return atoms, bonds


def build_reactant():
    atoms, bonds =3D build_common_scaffold()
    zr_idx =3D 0
    zr =3D atoms[zr_idx][1]
    # Zr-CH3
    c_me =3D np.array([2.15, -0.65, -0.35])
    me_idx =3D add_ch3(atoms, bonds, c_me, zr, zr_idx, bond_type=3D'solid')
    # Coordinated ethylene; proximal carbon interacts with Zr, C=3DC retain=
ed
    c_a =3D np.array([2.35, 0.70, 0.45])  # proximal CH2
    c_b =3D np.array([3.63, 1.05, 0.45])  # distal CH2
    # Add alkene carbons/hydrogens in a common plane
    plane_n =3D np.array([0.0, 0.0, 1.0])
    cb_idx =3D add_ch2_sp2(atoms, bonds, c_b, c_a, None if False else -1, p=
lane_n, bond_type=3D'solid')
    # fix: temporary invalid bond; rebuild correctly below
    # remove temporary entries for cb bond
    atoms2 =3D atoms[:-3]
    bonds2 =3D bonds[:-3]
    atoms, bonds =3D atoms2, bonds2
    a_idx =3D len(atoms)
    atoms.append(('C', c_a))
    b_idx =3D len(atoms)
    atoms.append(('C', c_b))
    bonds.append((a_idx, b_idx, 'double'))
    bonds.append((zr_idx, a_idx, 'partial'))
    # hydrogens on alkene, planar
    u_ab =3D norm(c_b - c_a)
    n =3D norm(plane_n)
    v =3D norm(np.cross(n, u_ab))
    for cpos, other_u_idx, signset in [(c_a, u_ab, [+1, -1]), (c_b, -u_ab, =
[+1, -1])]:
        cidx =3D a_idx if np.allclose(cpos, c_a) else b_idx
        u =3D other_u_idx
        for sgn in signset:
            d =3D norm(-0.5*u + sgn*(np.sqrt(3)/2.0)*v)
            h =3D cpos + 1.08*d
            atoms.append(('H', h))
            bonds.append((cidx, len(atoms)-1, 'solid'))
    return atoms, bonds


def build_ts_like():
    atoms, bonds =3D build_common_scaffold()
    zr_idx =3D 0
    zr =3D atoms[zr_idx][1]
    c_a =3D np.array([2.20, 0.55, 0.45])   # alpha carbon becoming Zr-bound
    c_b =3D np.array([3.55, 1.10, 0.20])   # beta carbon
